# Copie para .env.local e substitua pelo endereço do seu PostgreSQL.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require"
SITE_URL="http://localhost:3000"
# Mantém as consultas da aplicação em modo somente leitura durante a validação.
DATABASE_READ_ONLY=true
# Opcional: restringe o acesso ao MCP remoto por Bearer token.
# MCP_ACCESS_TOKEN=""
# Opcional: acionamento autenticado do ETL via GitHub Actions.
GITHUB_REPO="Josias-Kautzmann/siveplens"
# GITHUB_TOKEN=""
# ETL_SECRET=""
